{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "composite": true,
    "outDir": "../dist/scripts"
  },
  "include": ["./*.ts"],
  "exclude": ["../node_modules"]
}
